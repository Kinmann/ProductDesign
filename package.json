{
  "name": "specflow",
  "private": true,
  "description": "AI-native spec pipeline: PRD → FDD → IA linked to an ontology graph with change impact analysis",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.9.0",
    "eslint": "9.15.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.8"
  }
}
